{
  "$id": "myoutbrain://schema/domain-request-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {"minLength": 1, "type": "string"},
          "type": "array",
          "uniqueItems": true
        },
        "name": {"minLength": 1, "type": "string"}
      },
      "required": ["name", "capabilities"],
      "type": "object"
    },
    "operation": {"minLength": 1, "type": "string"},
    "parameters": {"type": "object"},
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "maximum": {"$ref": "#/$defs/version"},
        "minimum": {"$ref": "#/$defs/version"}
      },
      "required": ["minimum", "maximum"],
      "type": "object"
    },
    "write": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {"minimum": 0, "type": "integer"},
        "idempotency_key": {"maxLength": 200, "minLength": 1, "type": "string"}
      },
      "required": ["idempotency_key", "expected_version"],
      "type": "object"
    }
  },
  "required": ["protocol", "client", "operation", "parameters"],
  "type": "object",
  "$defs": {
    "version": {
      "additionalProperties": false,
      "properties": {
        "major": {"minimum": 0, "type": "integer"},
        "minor": {"minimum": 0, "type": "integer"}
      },
      "required": ["major", "minor"],
      "type": "object"
    }
  }
}
