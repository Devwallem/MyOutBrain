{
  "$id": "myoutbrain://schema/domain-response-v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "error": {
      "additionalProperties": false,
      "properties": {
        "category": {"minLength": 1, "type": "string"},
        "details": {"type": "object"},
        "message": {"minLength": 1, "type": "string"}
      },
      "required": ["category", "message", "details"],
      "type": "object"
    },
    "ok": {"type": "boolean"},
    "operation": {"type": ["string", "null"]},
    "protocol_version": {"$ref": "domain-request-v2.json#/$defs/version"},
    "result": {"type": "object"},
    "server_capabilities": {"items": {"type": "string"}, "type": "array"},
    "server_protocol_version": {"$ref": "domain-request-v2.json#/$defs/version"}
  },
  "required": ["ok", "operation", "server_protocol_version"],
  "type": "object"
}
